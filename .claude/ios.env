# ios-ai-kit configuration (committed). Per-checkout values go in .claude/ios.local.env (gitignored).
PROJECT=Project-Ezra.xcodeproj
SCHEME=Project-Ezra
APP_BUNDLE_ID=amanze-studios.Project-Ezra
IOS_VERSION=
DEVICE_MODEL=iPhone 17 Pro
MIN_XCODE=27
SOURCE_DIRS=Project-Ezra
TEST_FLAGS=-parallel-testing-enabled NO
BASE_LAUNCH_ARGS=-SeedFlowFixtures
# Cloud sessions (no human to answer a prompt): the gate pushes only branches under this prefix
# and opens a PR; CLOUD_PUBLISH=0 refuses every push there (you publish by hand).
CLOUD_BRANCH_PREFIX=claude/
CLOUD_PUBLISH=1
